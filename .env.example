# Example environment file (do NOT commit real secrets)
DB_DRIVER=oracle+oracledb
DB_USER=your_username
DB_PASS=your_password_here
DB_HOST=your_host
DB_PORT=1977
DB_SERVICE=your_service_name

# Or provide a single DATABASE_URL
# DATABASE_URL=oracle+oracledb://user:pass@host:port/?service_name=service
